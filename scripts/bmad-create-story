#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  bmad-create-story STORY-ID ["Title"] [--goal "..."] [--context "..."] [--force]

Examples:
  ./scripts/bmad-create-story STORY-001 "Add portfolio import" --goal "Import CSV" --context "For Avanza exports"
EOF
}

if [[ ${1:-} == "-h" || ${1:-} == "--help" || ${1:-} == "" ]]; then
  usage
  exit 0
fi

STORY_ID="$1"
shift

TITLE=""
if [[ ${1:-} != "" && ${1:-} != --* ]]; then
  TITLE="$1"
  shift
fi

GOAL=""
CONTEXT=""
FORCE="false"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --goal)
      GOAL="${2:-}"
      shift 2
      ;;
    --context)
      CONTEXT="${2:-}"
      shift 2
      ;;
    --force)
      FORCE="true"
      shift
      ;;
    *)
      echo "Unknown arg: $1" >&2
      usage
      exit 2
      ;;
  esac
done

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OUT_DIR="$ROOT_DIR/stories/$STORY_ID"

if [[ -d "$OUT_DIR" && "$FORCE" != "true" ]]; then
  echo "Story already exists: $OUT_DIR" >&2
  echo "Re-run with --force to overwrite." >&2
  exit 3
fi

mkdir -p "$OUT_DIR"

render() {
  local tmpl="$1"
  local out="$2"

  # Portable template replacement (macOS sed compatible)
  local tmp
  tmp="$(mktemp)"
  cp "$tmpl" "$tmp"

  sed -i '' \
    -e "s/{{story_id}}/${STORY_ID//\//-}/g" \
    -e "s/{{title}}/${TITLE//\//-}/g" \
    -e "s/{{goal}}/${GOAL//\//-}/g" \
    -e "s/{{context}}/${CONTEXT//\//-}/g" \
    "$tmp"

  mv "$tmp" "$out"
}

TMPL_DIR="$ROOT_DIR/.bmad/templates"
render "$TMPL_DIR/story.md.tmpl"  "$OUT_DIR/story.md"
render "$TMPL_DIR/tasks.md.tmpl"  "$OUT_DIR/tasks.md"
render "$TMPL_DIR/notes.md.tmpl"  "$OUT_DIR/notes.md"
render "$TMPL_DIR/qa.md.tmpl"     "$OUT_DIR/qa.md"

cat > "$OUT_DIR/README.md" <<EOF
# $STORY_ID

- Story: ./story.md
- Tasks: ./tasks.md
- Notes: ./notes.md
- QA:    ./qa.md
EOF

echo "Created story: $OUT_DIR"
